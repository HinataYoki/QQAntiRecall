<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:QQAntiRecall.App.ViewModels"
        x:Class="QQAntiRecall.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        x:CompileBindings="True"
        mc:Ignorable="d"
        d:DesignWidth="960"
        d:DesignHeight="720"
        Title="QQ 防撤回"
        Icon="/Assets/avalonia-logo.ico"
        Width="960"
        Height="720"
        MinWidth="760"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="64,*">
        <Border Grid.Row="0" Classes="app-header">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="{StaticResource Space3}">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="{StaticResource RadiusLg}"
                            Background="{DynamicResource AccentBrush}"
                            BoxShadow="{DynamicResource ShadowSm}">
                        <LucideIcon Kind="ShieldCheck"
                                    Size="{StaticResource IconSizeLg}"
                                    StrokeWidth="2"
                                    Foreground="{DynamicResource TextOnAccentBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Space1}">
                        <TextBlock Classes="h1" Text="QQ 防撤回" />
                        <TextBlock Classes="muted" Text="QQ NT 补丁管理" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="{StaticResource Space2}"
                            VerticalAlignment="Center">
                    <LucideIcon Kind="MonitorCog"
                                Foreground="{DynamicResource AccentBrush}"
                                AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="{Binding PlatformLabel}"
                               FontSize="{StaticResource FontSizeSm}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <Border x:Name="StatusRail"
                    Grid.Column="0"
                    Classes="status-rail">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <TextBlock Classes="label"
                                   Text="环境状态"
                                   VerticalAlignment="Center" />
                        <Button x:Name="ScanButton"
                                Grid.Column="1"
                                Classes="secondary icon"
                                Command="{Binding ScanCommand}"
                                ToolTip.Tip="重新扫描 QQ 状态"
                                AutomationProperties.Name="重新扫描 QQ 版本"
                                AutomationProperties.AutomationId="target.scan">
                            <LucideIcon Kind="RefreshCw"
                                        AutomationProperties.AccessibilityView="Raw" />
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1"
                                Margin="{StaticResource RailSectionMargin}"
                                Spacing="{StaticResource Space5}">
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="{StaticResource Space3}">
                            <Border Classes="rail-icon"
                                    Classes.warning="{Binding IsQqRunning}">
                                <LucideIcon Kind="MonitorCog"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Space1}">
                                <TextBlock Classes="muted" Text="QQ 进程" />
                                <TextBlock Classes="rail-value"
                                           Classes.warning="{Binding IsQqRunning}"
                                           Text="{Binding QqProcessStatus}"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="32,*" ColumnSpacing="{StaticResource Space3}">
                            <Border Classes="rail-icon"
                                    Classes.success="{Binding IsStatusSuccess}"
                                    Classes.warning="{Binding IsStatusWarning}"
                                    Classes.error="{Binding IsStatusError}">
                                <LucideIcon Kind="ShieldCheck"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Space1}">
                                <TextBlock Classes="muted" Text="补丁状态" />
                                <TextBlock Classes="rail-value"
                                           Classes.success="{Binding IsStatusSuccess}"
                                           Classes.warning="{Binding IsStatusWarning}"
                                           Classes.error="{Binding IsStatusError}"
                                           Text="{Binding StatusTitle}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="32,*" ColumnSpacing="{StaticResource Space3}">
                            <Border Classes="rail-icon">
                                <LucideIcon Kind="PackageSearch"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Space1}">
                                <TextBlock Classes="muted" Text="QQ 版本" />
                                <TextBlock Classes="rail-value" Text="{Binding VersionStatus}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="32,*" ColumnSpacing="{StaticResource Space3}">
                            <Border Classes="rail-icon">
                                <LucideIcon Kind="ArchiveRestore"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AccessibilityView="Raw" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Space1}">
                                <TextBlock Classes="muted" Text="本地备份" />
                                <TextBlock Classes="rail-value" Text="{Binding BackupStatus}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Margin="0,28,0,0"
                                Spacing="{StaticResource Space3}">
                        <Border Classes="divider" />
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="{StaticResource Space2}">
                            <LucideIcon Kind="ShieldCheck"
                                        Foreground="{DynamicResource AccentBrush}"
                                        AutomationProperties.AccessibilityView="Raw" />
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Space1}">
                                <TextBlock Classes="muted" Text="修改范围" />
                                <TextBlock Classes="rail-value" Text="仅已验证版本" />
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="{StaticResource Space2}">
                            <LucideIcon Kind="HardDrive"
                                        Foreground="{DynamicResource AccentBrush}"
                                        AutomationProperties.AccessibilityView="Raw" />
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Space2}">
                                <StackPanel Spacing="{StaticResource Space1}">
                                    <TextBlock Classes="muted" Text="备份存储" />
                                    <TextBlock Classes="rail-value" Text="用户本地目录" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                                    <Button x:Name="OpenBackupDirectoryButton"
                                            Classes="secondary icon"
                                            Command="{Binding OpenBackupDirectoryCommand}"
                                            ToolTip.Tip="打开备份目录"
                                            AutomationProperties.Name="打开备份目录"
                                            AutomationProperties.AutomationId="backup.open-directory">
                                        <LucideIcon Kind="FolderOpen"
                                                    AutomationProperties.AccessibilityView="Raw" />
                                    </Button>
                                    <Button x:Name="CleanupBackupsButton"
                                            Classes="secondary icon"
                                            Command="{Binding CleanupBackupsCommand}"
                                            ToolTip.Tip="清理旧版本和重复备份"
                                            AutomationProperties.Name="清理旧版本和重复备份"
                                            AutomationProperties.AutomationId="backup.cleanup">
                                        <LucideIcon Kind="Trash2"
                                                    AutomationProperties.AccessibilityView="Raw" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Spacing="{StaticResource Space2}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{DynamicResource SuccessBrush}"
                                     VerticalAlignment="Center"
                                     AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Classes="muted" Text="MIT 开源软件" />
                        </StackPanel>
                        <TextBlock Classes="muted platform-detail"
                                   Text="{Binding PlatformDetail}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Classes="main-content"
                                MaxWidth="840"
                                Margin="{StaticResource PagePadding}"
                                HorizontalAlignment="Stretch"
                                Spacing="0">
                        <StackPanel Spacing="{StaticResource Space4}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="{StaticResource Space2}"
                                            VerticalAlignment="Center">
                                    <TextBlock Classes="muted mono" Text="01" />
                                    <TextBlock Classes="h2" Text="安装目录" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Classes="status-pill"
                                        Classes.warning="{Binding IsQqRunning}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
                                        <LucideIcon Kind="MonitorCog"
                                                    Size="{StaticResource IconSizeSm}"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Text="{Binding QqProcessStatus}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space3}">
                                <StackPanel Spacing="{StaticResource Space1}">
                                    <TextBlock x:Name="InstallPathLabel"
                                               Classes="label"
                                               Text="QQ 程序目录" />
                                    <TextBox x:Name="InstallPathBox"
                                             Classes="mono"
                                             Text="{Binding InstallPath, Mode=TwoWay}"
                                             PlaceholderText="选择包含 QQ.exe 与 versions 的目录"
                                             AutomationProperties.LabeledBy="{Binding #InstallPathLabel}"
                                             AutomationProperties.AutomationId="install.path" />
                                </StackPanel>
                                <Button x:Name="BrowseButton"
                                        Grid.Column="1"
                                        Classes="secondary icon"
                                        Margin="0,17,0,0"
                                        Command="{Binding BrowseCommand}"
                                        ToolTip.Tip="选择 QQ 安装目录"
                                        AutomationProperties.Name="选择 QQ 安装目录"
                                        AutomationProperties.AutomationId="install.browse">
                                    <LucideIcon Kind="FolderOpen"
                                                AutomationProperties.AccessibilityView="Raw" />
                                </Button>
                            </Grid>

                            <Border Classes="status-band"
                                    Classes.success="{Binding IsStatusSuccess}"
                                    Classes.warning="{Binding IsStatusWarning}"
                                    Classes.error="{Binding IsStatusError}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space3}">
                                    <LucideIcon Kind="SquareActivity"
                                                Size="{StaticResource IconSizeLg}"
                                                VerticalAlignment="Top"
                                                AutomationProperties.AccessibilityView="Raw" />
                                    <StackPanel Grid.Column="1" Spacing="{StaticResource Space1}">
                                        <TextBlock x:Name="StatusTitleText"
                                                   Classes="h2"
                                                   Text="{Binding StatusTitle}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   AutomationProperties.AutomationId="status.title" />
                                        <TextBlock Classes="secondary"
                                                   Text="{Binding StatusDetail}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Classes="busy-strip" IsVisible="{Binding IsBusy}">
                                <Grid RowDefinitions="Auto,Auto"
                                      RowSpacing="{StaticResource Space2}">
                                    <TextBlock Text="{Binding BusyText}"
                                               TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <ProgressBar Grid.Row="1"
                                                 Classes="busy-progress"
                                                 IsIndeterminate="True"
                                                 AutomationProperties.AccessibilityView="Raw" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <Border Classes="divider" Margin="{StaticResource SectionDividerMargin}" />

                        <StackPanel Spacing="{StaticResource Space4}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="{StaticResource Space2}"
                                            VerticalAlignment="Center">
                                    <TextBlock Classes="muted mono" Text="02" />
                                    <TextBlock Classes="h2" Text="QQ 版本" />
                                </StackPanel>
                                <Border Grid.Column="1" Classes="status-pill">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space1}">
                                        <LucideIcon Kind="PackageSearch"
                                                    Size="{StaticResource IconSizeSm}"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    AutomationProperties.AccessibilityView="Raw" />
                                        <TextBlock Text="{Binding VersionStatus}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <ItemsControl x:Name="TargetList"
                                          ItemsSource="{Binding Targets}"
                                          IsVisible="{Binding HasTargets}"
                                          AutomationProperties.Name="可处理的 QQ 版本"
                                          AutomationProperties.AutomationId="target.list">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TargetItemViewModel">
                                        <Border Classes="target-row">
                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                                  ColumnDefinitions="Auto,*,Auto"
                                                  RowSpacing="{StaticResource Space2}"
                                                  ColumnSpacing="{StaticResource Space3}">
                                                <TextBlock Classes="target-version"
                                                           Text="{Binding Version}"
                                                           VerticalAlignment="Center" />

                                                <Border Grid.Column="2"
                                                        Classes="state-badge"
                                                        Classes.ready="{Binding IsReady}"
                                                        Classes.installed="{Binding IsInstalled}"
                                                        Classes.problem="{Binding IsProblem}"
                                                        AutomationProperties.Name="版本状态">
                                                    <TextBlock Text="{Binding StateLabel}" />
                                                </Border>

                                                <TextBlock Grid.Row="1"
                                                           Grid.ColumnSpan="3"
                                                           Classes="secondary"
                                                           Text="{Binding Detail}"
                                                           TextWrapping="Wrap" />

                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="0"
                                                           Classes="metadata-label"
                                                           Text="SHA-256" />
                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="1"
                                                           Grid.ColumnSpan="2"
                                                           Classes="metadata-value mono"
                                                           Text="{Binding ShortHash}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Sha256}" />

                                                <TextBlock Grid.Row="3"
                                                           Grid.Column="0"
                                                           Classes="metadata-label"
                                                           Text="文件" />
                                                <TextBlock Grid.Row="3"
                                                           Grid.Column="1"
                                                           Grid.ColumnSpan="2"
                                                           Classes="metadata-value"
                                                           Text="{Binding FilePath}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding FilePath}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Classes="empty-state" IsVisible="{Binding HasNoTargets}">
                                <StackPanel Spacing="{StaticResource Space3}"
                                            HorizontalAlignment="Center">
                                    <LucideIcon Kind="PackageSearch"
                                                Size="{StaticResource IconSizeXl}"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                HorizontalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Classes="h2"
                                               Text="未发现 QQ 版本"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Classes="muted"
                                               Text="选择有效的 QQ 安装目录后重新扫描"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" Classes="command-bar">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space4}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{StaticResource Space2}"
                                    VerticalAlignment="Center">
                            <LucideIcon Kind="PackageSearch"
                                        Foreground="{DynamicResource AccentBrush}"
                                        AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Classes="muted"
                                       Text="{Binding VersionStatus}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="{StaticResource Space2}"
                                    HorizontalAlignment="Right">
                            <Button x:Name="RestoreButton"
                                    Classes="secondary action"
                                    Command="{Binding RestoreCommand}"
                                    IsEnabled="{Binding CanRestore}"
                                    AutomationProperties.Name="恢复 QQ 原始文件"
                                    AutomationProperties.AutomationId="patch.restore">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="{StaticResource Space2}"
                                            VerticalAlignment="Center">
                                    <LucideIcon Kind="RotateCcw"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="恢复备份"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="InstallButton"
                                    Classes="primary"
                                    Command="{Binding InstallCommand}"
                                    IsVisible="{Binding ShowStandardInstallAction}"
                                    IsEnabled="{Binding CanInstall}"
                                    AutomationProperties.Name="安装 QQ 防撤回补丁"
                                    AutomationProperties.AutomationId="patch.install">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                                    <LucideIcon Kind="ShieldCheck"
                                                AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="安装补丁" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="CloseQqInstallAndRestartButton"
                                    Classes="primary"
                                    Command="{Binding CloseQqInstallAndRestartCommand}"
                                    IsVisible="{Binding ShowCloseQqInstallAndRestart}"
                                    IsEnabled="{Binding CanCloseQqInstallAndRestart}"
                                    AutomationProperties.Name="关闭 QQ，安装防撤回补丁并重新启动 QQ"
                                    AutomationProperties.AutomationId="patch.close-install-restart">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}">
                                    <LucideIcon Kind="RefreshCw"
                                                AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Text="关闭 QQ · 安装并重启" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
