<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
    <Color x:Key="Neutral0">#FFFFFF</Color>
    <Color x:Key="Neutral50">#F4F7F9</Color>
    <Color x:Key="Neutral75">#F9FBFC</Color>
    <Color x:Key="Neutral100">#ECF3F6</Color>
    <Color x:Key="Neutral200">#D5E1E7</Color>
    <Color x:Key="Neutral350">#A4B5BE</Color>
    <Color x:Key="Neutral500">#61737D</Color>
    <Color x:Key="Neutral650">#43535C</Color>
    <Color x:Key="Neutral850">#202A2F</Color>
    <Color x:Key="Neutral900">#192126</Color>
    <Color x:Key="Neutral925">#151C20</Color>
    <Color x:Key="Neutral950">#11171A</Color>
    <Color x:Key="NeutralLightText">#F2F6F8</Color>
    <Color x:Key="Accent300">#68BADB</Color>
    <Color x:Key="Accent600">#176F9E</Color>
    <Color x:Key="Accent700">#115E88</Color>
    <Color x:Key="Success600">#237A57</Color>
    <Color x:Key="Warning700">#94620A</Color>
    <Color x:Key="Danger600">#B33A3A</Color>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource Neutral50}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FBFCFD" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource Neutral0}" />
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource Neutral100}" />
            <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#F1F6F8" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E5EEF2" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#17232A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource Neutral650}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource Neutral500}" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource Neutral0}" />
            <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Neutral200}" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource Neutral350}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent600}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource Accent700}" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#E1F1F8" />
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success600}" />
            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#E3F2EA" />
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning700}" />
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="#FFF1D2" />
            <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger600}" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#FBE8E7" />
            <SolidColorBrush x:Key="DisabledBrush" Color="#96A4AB" />
            <BoxShadows x:Key="ShadowSm">0 1 3 0 #20000000</BoxShadows>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource Neutral950}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Neutral900}" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource Neutral850}" />
            <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource Neutral925}" />
            <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#253138" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#2A3941" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource NeutralLightText}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C1CDD2" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#98A9B1" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#07151C" />
            <SolidColorBrush x:Key="BorderBrush" Color="#33434C" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#536874" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent300}" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#83C9E5" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#173746" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#65C89A" />
            <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#17382B" />
            <SolidColorBrush x:Key="WarningBrush" Color="#E8B85D" />
            <SolidColorBrush x:Key="WarningSubtleBrush" Color="#3D3017" />
            <SolidColorBrush x:Key="DangerBrush" Color="#F08080" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#412222" />
            <SolidColorBrush x:Key="DisabledBrush" Color="#697980" />
            <BoxShadows x:Key="ShadowSm">0 1 2 0 #44000000</BoxShadows>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <sys:Double x:Key="FontSizeXs">11</sys:Double>
    <sys:Double x:Key="FontSizeSm">12</sys:Double>
    <sys:Double x:Key="FontSizeBase">14</sys:Double>
    <sys:Double x:Key="FontSizeMd">16</sys:Double>
    <sys:Double x:Key="FontSizeLg">18</sys:Double>
    <sys:Double x:Key="FontSizeXl">22</sys:Double>

    <sys:Double x:Key="Space1">4</sys:Double>
    <sys:Double x:Key="Space2">8</sys:Double>
    <sys:Double x:Key="Space3">12</sys:Double>
    <sys:Double x:Key="Space4">16</sys:Double>
    <sys:Double x:Key="Space5">20</sys:Double>
    <sys:Double x:Key="Space6">24</sys:Double>
    <sys:Double x:Key="Space8">32</sys:Double>

    <sys:Double x:Key="IconSizeSm">14</sys:Double>
    <sys:Double x:Key="IconSizeMd">16</sys:Double>
    <sys:Double x:Key="IconSizeLg">20</sys:Double>
    <sys:Double x:Key="IconSizeXl">32</sys:Double>
    <sys:Double x:Key="ControlHeight">38</sys:Double>
    <sys:Double x:Key="DisabledOpacity">0.55</sys:Double>

    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="RadiusFull">999</CornerRadius>

    <Thickness x:Key="HeaderPadding">22,0</Thickness>
    <Thickness x:Key="PagePadding">30,24</Thickness>
    <Thickness x:Key="PagePaddingCompact">18,20</Thickness>
    <Thickness x:Key="RailPadding">18,22,18,16</Thickness>
    <Thickness x:Key="RailPaddingCompact">14,18,14,14</Thickness>
    <Thickness x:Key="ControlPadding">12,8</Thickness>
    <Thickness x:Key="ButtonPadding">14,8</Thickness>
    <Thickness x:Key="PrimaryButtonPadding">18,10</Thickness>
    <Thickness x:Key="IconButtonPadding">8</Thickness>
    <Thickness x:Key="StatusBandPadding">14,12</Thickness>
    <Thickness x:Key="TargetRowPadding">16</Thickness>
    <Thickness x:Key="TargetRowMargin">0,0,0,8</Thickness>
    <Thickness x:Key="CommandBarPadding">16,12,24,16</Thickness>
    <Thickness x:Key="CommandBarPaddingCompact">12,12,16,16</Thickness>
    <Thickness x:Key="SectionDividerMargin">0,24</Thickness>
    <Thickness x:Key="RailSectionMargin">0,24,0,0</Thickness>
    <Thickness x:Key="BadgePadding">8,4</Thickness>
</ResourceDictionary>
