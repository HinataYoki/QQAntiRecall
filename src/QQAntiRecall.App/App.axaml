<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QQAntiRecall.App.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://QQAntiRecall/Resources/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://QQAntiRecall/Styles/AppStyles.axaml" />
        <StyleInclude Source="avares://QQAntiRecall/Styles/MainWindowStyles.axaml" />
    </Application.Styles>
</Application>
